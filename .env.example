# Advanced AI Medical Intelligence Platform - Environment Variables
# Copy this file to .env and fill in your values

# --- LLM Report Generation (xAI Grok API, OpenAI-compatible) ---
# Obtain your API key from https://console.x.ai/
XAI_API_KEY=
GROK_MODEL=grok-3-mini

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (React/Vite) ---
# URL the React frontend uses to reach the backend API.
# For local dev: leave blank (Vite dev proxy handles it automatically)
# For production / Docker: set to http://localhost:8000 or http://backend:8000
VITE_API_BASE_URL=
